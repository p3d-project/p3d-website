---
import logo from '@assets/logo.png';
import { Image } from 'astro:assets';

const self = '/';
---

<div class="flex items-center gap-4">
  <a href={self} class="group flex">
    <Image
      src={logo}
      alt="Persona 3 Dual"
      class="h-[calc(var(--sl-nav-height)-2*var(--sl-nav-pad-y))] w-auto transition-transform duration-75 group-hover:-translate-y-1"
    />
  </a>
</div>
