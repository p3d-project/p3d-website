---
import Logo from '@assets/P3D_outline.svg';

const self = '/';
---

<div class="flex items-center gap-4">
  <a href={self} class="group flex">
    <Logo
      class="h-[calc(var(--sl-nav-height)-2*var(--sl-nav-pad-y))] max-h-12 w-auto transition-transform duration-75 group-hover:-translate-y-1"
    />
  </a>
</div>
